{
  "manifest_version": 2,
  "name": "Note Preview Column / 笔记摘要列",
  "version": "1.1.0",
  "description": "Shows note text directly in a custom Zotero item-list column, including standalone PDF attachment notes.",
  "author": "Codex for the local user",
  "homepage_url": "https://github.com/ZhangHangjia/zotero-note-preview-column",
  "icons": {
    "48": "icons/note-preview-column.svg",
    "96": "icons/note-preview-column.svg"
  },
  "applications": {
    "zotero": {
      "id": "note-preview-column@local.codex",
      "update_url": "https://raw.githubusercontent.com/ZhangHangjia/zotero-note-preview-column/main/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
